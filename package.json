{
  "name": "@rckflr/agent-tools-runtime",
  "version": "0.2.6",
  "type": "module",
  "description": "Persistent just-bash runtime with progressive MCP, REST and CLI adapter discovery.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "agent-tools": "bin/agent-tools.mjs",
    "agent-tools-mcp": "bin/agent-tools-mcp.mjs",
    "agent-tools-mcp-http": "bin/agent-tools-mcp-http.mjs"
  },
  "files": [
    "README.md",
    "LICENSE",
    "adapters",
    "bin",
    "commands",
    "runtime",
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "just-bash": "^3.2.0"
  },
  "scripts": {
    "probe": "node scripts/runtime_probe.mjs --json",
    "validate-plugins": "node scripts/validate-plugins.mjs",
    "serve": "node runtime/agent-tools-runtime.mjs serve",
    "mcp": "node runtime/mcp-server.mjs",
    "mcp:http": "node runtime/mcp-http-server.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
